COLECTICA_BASE_URL=https://your-colectica-portal.example.org

# Auth (supports both; default behavior prefers bearer when set, then basic).
COLECTICA_BEARER_TOKEN=
COLECTICA_USERNAME=
COLECTICA_PASSWORD=

# Optional settings.
COLECTICA_VERIFY_SSL=true
COLECTICA_TIMEOUT_SECONDS=30
COLECTICA_OPENAPI_CACHE_TTL_SECONDS=300
COLECTICA_RETRY_MAX_RETRIES=2
COLECTICA_RETRY_BASE_SECONDS=0.5
COLECTICA_RETRY_MAX_SECONDS=8
COLECTICA_MCP_TRANSPORT=stdio
COLECTICA_MCP_MOUNT_PATH=/mcp

# ── Container / HTTP mode ──────────────────────────────────────────────────
# Set COLECTICA_MCP_TRANSPORT=streamable-http to run as an HTTP server
# (used when hosting in Docker / Azure Container Apps / ACI).
# COLECTICA_MCP_TRANSPORT=streamable-http
# COLECTICA_MCP_HOST=0.0.0.0
# COLECTICA_MCP_PORT=8000

# ── Purview MCP Server (docker-compose.yml) ────────────────────────────────
PURVIEW_MCP_IMAGE=purview-mcp-server:latest
PURVIEW_ENDPOINT=https://your-purview-account.purview.azure.com

# ── Azure Identity (service principal — leave blank for Managed Identity) ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Azure AI Foundry (foundry_agent) ──────────────────────────────────────
AZURE_AI_PROJECT_ENDPOINT=https://your-hub.api.azureml.ms
AZURE_AI_MODEL=gpt-4o
