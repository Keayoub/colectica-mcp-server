COLECTICA_BASE_URL=https://your-colectica-portal.example.org

# Auth (supports both; default behavior prefers bearer when set, then basic).
COLECTICA_BEARER_TOKEN=
COLECTICA_USERNAME=
COLECTICA_PASSWORD=

# Optional settings.
COLECTICA_VERIFY_SSL=true
COLECTICA_TIMEOUT_SECONDS=30
COLECTICA_OPENAPI_CACHE_TTL_SECONDS=300
COLECTICA_RETRY_MAX_RETRIES=2
COLECTICA_RETRY_BASE_SECONDS=0.5
COLECTICA_RETRY_MAX_SECONDS=8
COLECTICA_MCP_TRANSPORT=stdio
COLECTICA_MCP_MOUNT_PATH=/mcp
